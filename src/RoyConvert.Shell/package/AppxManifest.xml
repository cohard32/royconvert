<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package that gives royconvert_shell.dll's IExplorerCommand a place in the Windows 11 context menu.
  It holds only this manifest and logos; the files stay in the install folder, passed as -ExternalLocation.
  Unsigned (the OID in Publisher marks it), installed with Add-AppxPackage -AllowUnsigned, which Windows 11 supports.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="royconvert.ContextMenu" Publisher="CN=royconvert, OID.2.25.311729368913984317654407730594956997722=1"
            Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>royconvert</DisplayName>
    <PublisherDisplayName>royconvert</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="royconvert" Executable="royconvert.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="royconvert" Description="royconvert file converter" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
                          AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- Every file; the handler hides itself when no preset accepts the selection. -->
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="royconvert" Clsid="F350E4E0-298E-47B5-9E43-F82D43D99A06" />
            </desktop5:ItemType>
            <!-- Folders, for DVDs (VIDEO_TS); hidden for any other folder. -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="royconvert" Clsid="F350E4E0-298E-47B5-9E43-F82D43D99A06" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="royconvert context menu">
              <com:Class Id="F350E4E0-298E-47B5-9E43-F82D43D99A06" Path="royconvert_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
