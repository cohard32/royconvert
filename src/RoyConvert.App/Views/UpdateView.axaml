<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoyConvert.App.ViewModels"
             xmlns:res="using:RoyConvert.App.Resources"
             x:Class="RoyConvert.App.Views.UpdateView"
             x:DataType="vm:UpdateViewModel"
             IsVisible="{Binding IsVisible}">
    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="12,10">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsDownloading}">
                    <Button Content="{x:Static res:Strings.Update_Later}" Command="{Binding LaterCommand}" />
                    <Button Content="{x:Static res:Strings.Update_Install}" Command="{Binding InstallCommand}" Classes="accent" />
                </StackPanel>
            </Grid>
            <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsDownloading}" />
        </StackPanel>
    </Border>
</UserControl>
