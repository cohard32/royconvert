<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoyConvert.App.ViewModels"
        xmlns:res="using:RoyConvert.App.Resources"
        x:Class="RoyConvert.App.Views.ProgressWindow"
        x:DataType="vm:ProgressViewModel"
        Title="royconvert"
        Icon="/Assets/royconvert.ico"
        Width="560" SizeToContent="Height" MaxHeight="640" MinHeight="160"
        CanResize="False" WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{x:Static res:Strings.Progress_CancelAll}" Command="{Binding CancelAllCommand}"
                    IsVisible="{Binding !AllFinished}" />
        </Grid>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Messages}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Foreground="#D13438" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobViewModel">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <TextBlock Text="{Binding PresetName}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.8" HorizontalAlignment="Right" />

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                                             VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="{x:Static res:Strings.Progress_Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding !IsFinished}" />
                                    <Button Content="{x:Static res:Strings.Progress_Show}" Command="{Binding ShowOutputCommand}" IsVisible="{Binding IsDone}" />
                                </StackPanel>
                            </Grid>

                            <SelectableTextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding IsFailed}"
                                                 Foreground="#D13438" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" MaxHeight="120" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
