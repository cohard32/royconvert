<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoyConvert.App.ViewModels"
        xmlns:res="using:RoyConvert.App.Resources"
        x:Class="RoyConvert.App.Views.ResizeWindow"
        x:DataType="vm:ResizeViewModel"
        Title="{Binding Title}"
        Icon="/Assets/royconvert.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Resize_ByPixels}" IsChecked="{Binding ByPixels}" />
            <RadioButton GroupName="Mode" Content="{x:Static res:Strings.Resize_ByPercent}" IsChecked="{Binding ByPercent}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ByPixels}">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.Resize_Width}" />
                <TextBox x:Name="WidthBox" Text="{Binding Width}" Watermark="{x:Static res:Strings.Resize_Any}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static res:Strings.Resize_Height}" />
                <TextBox Text="{Binding Height}" Watermark="{x:Static res:Strings.Resize_Any}" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="4" IsVisible="{Binding ByPercent}">
            <TextBlock Text="{x:Static res:Strings.Resize_Percent}" />
            <TextBox Text="{Binding Percent}" Width="120" HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{x:Static res:Strings.Resize_Hint}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

        <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <SelectableTextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="12" MaxHeight="120"
                             Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                             IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Static res:Strings.Watermark_Close}" Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Content="{x:Static res:Strings.Resize_Apply}" Command="{Binding ApplyCommand}" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
