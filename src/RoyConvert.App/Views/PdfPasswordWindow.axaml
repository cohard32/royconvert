<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoyConvert.App.ViewModels"
        xmlns:res="using:RoyConvert.App.Resources"
        x:Class="RoyConvert.App.Views.PdfPasswordWindow"
        x:DataType="vm:PdfPasswordViewModel"
        Title="{Binding Title}"
        Icon="/Assets/royconvert.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static res:Strings.Password_Password}" />
            <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="{Binding Mask}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding Protects}">
            <TextBlock Text="{x:Static res:Strings.Password_Repeat}" />
            <TextBox Text="{Binding Repeat}" PasswordChar="{Binding Mask}" />
        </StackPanel>

        <CheckBox Content="{x:Static res:Strings.Password_Show}" IsChecked="{Binding ShowPassword}" />

        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <SelectableTextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="12" MaxHeight="120"
                             Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                             IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Static res:Strings.Watermark_Close}" Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
