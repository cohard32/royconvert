<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>royconvert</AssemblyName>
    <RootNamespace>RoyConvert.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Also the installer version (installer/build-installer.ps1). -->
    <Version>0.1.0</Version>
    <!-- Also the icon of the Explorer menu, which royconvert_shell.dll reads from the exe. -->
    <ApplicationIcon>Assets\royconvert.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets\icon holds the SVG source of royconvert.ico. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\icon\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text; Strings.tr.resx holds the Turkish translation. The class is public for {x:Static} in XAML. -->
    <EmbeddedResource Update="Resources\Strings.resx" StronglyTypedLanguage="C#" StronglyTypedNamespace="RoyConvert.App.Resources"
                      StronglyTypedClassName="Strings" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoyConvert.Core\RoyConvert.Core.csproj" />
  </ItemGroup>

  <!--
    Explorer context menu handler (C++) and its Windows 11 sparse package, built with the Visual Studio C++ tools and
    the Windows SDK and placed next to royconvert.exe.
  -->
  <PropertyGroup>
    <ShellHandlerDir>$(MSBuildThisFileDirectory)..\RoyConvert.Shell\</ShellHandlerDir>
    <ShellHandlerDll>$(ShellHandlerDir)bin\royconvert_shell.dll</ShellHandlerDll>
    <ShellHandlerPackage>$(ShellHandlerDir)bin\royconvert_shell.msix</ShellHandlerPackage>
  </PropertyGroup>

  <ItemGroup>
    <ShellHandlerSource Include="$(ShellHandlerDir)RoyConvertShell.*;$(ShellHandlerDir)build.cmd;$(ShellHandlerDir)package\**" />
  </ItemGroup>

  <Target Name="BuildShellHandler" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'"
          Inputs="@(ShellHandlerSource)" Outputs="$(ShellHandlerDll);$(ShellHandlerPackage)">
    <Exec Command="&quot;$(ShellHandlerDir)build.cmd&quot;" />
  </Target>

  <Target Name="CopyShellHandler" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <!-- Explorer keeps the DLL loaded while a menu is in use; a failed copy only means the old handler stays. -->
    <Copy SourceFiles="$(ShellHandlerDll);$(ShellHandlerPackage)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Retries="0" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="PublishShellHandler" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(ShellHandlerDll);$(ShellHandlerPackage)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
